<UserControl
	x:Class="Provident.Xaml.Verify.Controls.SimpleTextEditorControl"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Provident.Xaml.Verify.Controls"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	d:DesignHeight="450"
	d:DesignWidth="800"
	mc:Ignorable="d">
	<Border>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="5" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="16" />
				<ColumnDefinition Width="5" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="16" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>
			<Label
				x:Name="WindowTitleLabel"
				Grid.Row="0"
				Grid.Column="1"
				Margin="0,-2,0,0"
				Padding="0,0,0,0"
				VerticalAlignment="Center"
				Background="#FF350084"
				Content="Edit A File"
				Foreground="White" />
			<Button
				x:Name="CloseButton"
				Grid.Row="0"
				Grid.Column="2"
				Height="16"
				Margin="0,-2,0,0"
				Padding="0,-2,0,0"
				Content="X" />
			<TextBox
				x:Name="TextEditor"
				Grid.Row="1"
				Grid.Column="1"
				Margin="0,0,0,0"
				AcceptsReturn="True"
				AcceptsTab="True"
				AutoWordSelection="True"
				Background="#FF151515"
				BorderThickness="0,0,0,0"
				FontFamily="Consolas"
				Foreground="#FF4483BA" />
		</Grid>
	</Border>
</UserControl>
