<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <RootNamespace>Provident.Xaml.Verify</RootNamespace>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>True</UseWPF>
    <AssemblyTitle>Provident Foundations XAML ID Verifier</AssemblyTitle>
	  <ApplicationVisualStyles>true</ApplicationVisualStyles>
	  <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
	  <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
	  <ApplicationDefaultFont>Segoe UI, 9.75pt</ApplicationDefaultFont>
	  <Platforms>AnyCPU;x64</Platforms>
    <DisableMSBuildAssemblyCopyCheck>true</DisableMSBuildAssemblyCopyCheck>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ProjectValidationErrorList.cs" />
    <Compile Remove="ProjectValidationErrorList.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="ProjectValidationErrorList.resx" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App Icon Source 32 x 32.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Microsoft.Build" ExcludeAssets="runtime" PrivateAssets="all" Version="18.11.0" />
    <PackageReference Include="Microsoft.Build.Framework" ExcludeAssets="runtime" PrivateAssets="all" Version="18.11.0" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" ExcludeAssets="runtime" PrivateAssets="all" Version="18.11.0" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" ExcludeAssets="runtime" PrivateAssets="all" Version="18.11.0" />
    <PackageReference Include="Microsoft.NET.StringTools" ExcludeAssets="runtime" PrivateAssets="all" Version="18.11.0" />
    <PackageReference Include="Microsoft.Build.Locator" PrivateAssets="all" Version="1.11.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Provident Foundations Visual studio Windows Forms Controls Library\Provident Foundations Visual studio Windows Forms Controls Library.csproj" />
    <ProjectReference Include="..\..\Provident Visual Studio Framework\Provident Visual Studio Framework.csproj" />
    <ProjectReference Include="..\..\Provident-Foundations-Framework\src\Core\Provident Foundations Framework\Provident.Foundations\Provident.Foundations.csproj" />
    <ProjectReference Include="..\..\Provident-Foundations-Framework\src\Windows\ui\Provident.Foundations.WinForms.Controls\Provident.Foundations.WinForms.Controls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="App Icon Source 32 x 32.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Validator\" />
  </ItemGroup>

</Project>