<Window
	x:Class="Provident.Xaml.Verify.PleaseWaitDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:Provident.Xaml.Verify"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Width="500"
	Height="50"
	HorizontalAlignment="Center"
	VerticalAlignment="Center"
	AllowsTransparency="True"
	Background="Transparent"
	Cursor="Wait"
	Icon="/App Icon Source 32 x 32.png"
	ResizeMode="NoResize"
	Topmost="True"
	WindowStartupLocation="CenterScreen"
	WindowStyle="None"
	mc:Ignorable="d">
	<Border
		Padding="5"
		Background="Transparent"
		BorderBrush="#FF9184EE"
		BorderThickness="2"
		CornerRadius="16">
		<StackPanel
			HorizontalAlignment="Center"
			VerticalAlignment="Center"
			Background="#FF1C1C1C"
			Orientation="Horizontal">
			<TextBlock
				x:Name="MessageLabel"
				Background="Transparent"
				FontFamily="Segoe UI"
				FontSize="16"
				FontWeight="Normal"
				Foreground="#FF9184EE"
				Text="Please Wait...">
				<TextBlock.Effect>
					<DropShadowEffect
						Direction="320"
						Opacity="0.5"
						ShadowDepth="5"
						Color="#9184EE" />
				</TextBlock.Effect>
			</TextBlock>
		</StackPanel>
	</Border>
</Window>
